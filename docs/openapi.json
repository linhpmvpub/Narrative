  "components": {
    "schemas": {
      "ApprovalBody": {
        "properties": {
          "confirmed": {
            "type": "boolean",
            "const": true,
            "title": "Confirmed"
          },
          "expected_version": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Expected Version"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "confirmed",
          "expected_version"
        ],
        "title": "ApprovalBody"
      },
      "EditBody": {
        "properties": {
          "primary_ticker": {
            "type": "string",
            "enum": [
              "MU",
              "NVDA",
              "AMD",
              "DELL",
              "SNDK"
            ],
            "title": "Primary Ticker"
          },
          "title": {
            "type": "string",
            "maxLength": 160,
            "minLength": 1,
            "title": "Title"
          },
          "thesis": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Thesis"
          },
          "horizon_months": {
            "type": "integer",
            "maximum": 60.0,
            "minimum": 1.0,
            "title": "Horizon Months"
          },
          "driver_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 3,
            "minItems": 1,
            "title": "Driver Ids"
          },
          "supporting_evidence": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 1,
            "title": "Supporting Evidence"
          },
          "challenging_evidence": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 1,
            "title": "Challenging Evidence"
          },
          "disconfirmation": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 1,
            "title": "Disconfirmation"
          },
          "outcomes": {
            "additionalProperties": {
              "type": "integer",
              "enum": [
                -1,
                1
              ]
            },
            "type": "object",
            "maxProperties": 3,
            "minProperties": 1,
            "title": "Outcomes"
          },
          "hypothesis_polarity": {
            "type": "string",
            "enum": [
              "favorable",
              "adverse"
            ],
            "title": "Hypothesis Polarity"
          },
          "max_hops": {
            "type": "integer",
            "enum": [
              0,
              1,
              2
            ],
            "title": "Max Hops",
            "default": 2
          },
          "expected_version": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Expected Version"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "primary_ticker",
          "title",
          "thesis",
          "horizon_months",
          "driver_ids",
          "supporting_evidence",
          "challenging_evidence",
          "disconfirmation",
          "outcomes",
          "hypothesis_polarity",
          "expected_version"
        ],
        "title": "EditBody"
      },
      "FeedbackBody": {
        "properties": {
          "label": {
            "type": "string",
            "enum": [
