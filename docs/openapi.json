            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Confidence",
            "default": 0
          },
          "routing_basis": {
            "type": "string",
            "maxLength": 2000,
            "title": "Routing Basis",
            "default": ""
          },
          "conditions": {
            "items": {
