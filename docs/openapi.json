              "UNCLEAR",
              "WRONG"
            ],
            "title": "Label"
          },
          "reason": {
            "type": "string",
            "maxLength": 2000,
            "title": "Reason",
            "default": ""
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "label"
        ],
        "title": "FeedbackBody"
      },
      "HTTPValidationError": {
        "properties": {
