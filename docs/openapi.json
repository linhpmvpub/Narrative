          },
          "challenging_evidence": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 1,
            "title": "Challenging Evidence"
          },
          "disconfirmation": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 1,
            "title": "Disconfirmation"
          },
          "outcomes": {
            "additionalProperties": {
              "type": "integer",
              "enum": [
                -1,
                1
              ]
            },
            "type": "object",
            "maxProperties": 3,
            "minProperties": 1,
            "title": "Outcomes"
          },
          "hypothesis_polarity": {
            "type": "string",
            "enum": [
              "favorable",
              "adverse"
            ],
            "title": "Hypothesis Polarity"
          },
          "max_hops": {
            "type": "integer",
            "enum": [
              0,
              1,
              2
            ],
            "title": "Max Hops",
            "default": 2
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "primary_ticker",
          "title",
          "thesis",
          "horizon_months",
          "driver_ids",
          "supporting_evidence",
          "challenging_evidence",
          "disconfirmation",
          "outcomes",
          "hypothesis_polarity"
        ],
        "title": "NarrativeBody"
      },
      "RelationReview": {
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "approve",
              "reject"
            ],
            "title": "Action"
          },
          "reason": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Reason"
          },
          "evidence_ids": {
            "items": {
