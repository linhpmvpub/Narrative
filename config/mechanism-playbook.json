  "rules": [
    {
      "id": "R01",
      "condition": "source_and_event_integrity",
      "failure": "REJECT_INVALID_INPUT"
    },
    {
      "id": "R02",
      "condition": "untruncated_paths",
      "failure": "HOLD_TRUNCATED"
    },
    {
      "id": "R03",
      "condition": "at_least_one_directed_path",
      "failure": "NO_PATH"
    },
    {
      "id": "R04",
      "condition": "phase_operating",
      "failure": "WATCH_PLAN_OR_COMMITMENT"
    },
    {
      "id": "R05",
      "condition": "event_exposure_scope_independently_reviewed",
      "failure": "REVIEW_SCOPE"
    },
    {
      "id": "R06",
      "condition": "relation_scoped_parameters_available",
      "failure": "REVIEW_DATA"
    },
    {
      "id": "R07",
      "condition": "causal_magnitude_and_timing_validated",
      "failure": "REVIEW_CAUSALITY"
    }
  ],
  "horizon_bins": {
    "short_max_days": 90,
    "medium_max_days": 365,
    "basis": "EDITORIAL_BINS_NOT_EMPIRICAL_LAGS"
  },
  "ranking_weights": null,
  "delivery": "disabled",
  "price_prediction": null,
  "sensitivity_models": {
    "COST_SENSITIVITY_V1": {
      "status": "SCENARIO_ONLY_NOT_CALIBRATED",
      "formula": "input_cost_share * unhedged_share * reset_share * price_change * (1-pass_through)",
      "output_unit": "fraction_of_same_period_baseline_cost",
      "inputs": {
        "input_cost_share": {
          "unit": "fraction",
          "min": 0,
          "max": 1,
          "meaning": "Affected input cost / same-period baseline cost pool; not revenue share."
        },
        "unhedged_share": {
          "unit": "fraction",
          "min": 0,
          "max": 1,
          "meaning": "Share of that input exposure without price protection."
        },
        "reset_share": {
          "unit": "fraction",
          "min": 0,
          "max": 1,
          "meaning": "Share of the unhedged slice whose purchase prices reset within the scenario period."
        },
        "price_change": {
          "unit": "fraction_change",
          "min": -1,
          "max": 10,
          "meaning": "Relative input price change; upper bound10 is a computational scenario limit, not an empirical threshold."
        },
        "pass_through": {
          "unit": "fraction",
          "min": 0,
          "max": 1,
          "meaning": "Realized recovery from customers / incremental cost of the same reset, unhedged slice."
        }
      },
      "assumptions": [
        "Same cost pool, scope and period",
        "Conditional fractions; do not multiply unrelated marginal shares",
        "Linear sensitivity; volumes, FX and demand fixed",
        "No profit, revenue, EPS or stock-price prediction"
      ]
    }
  }
}
