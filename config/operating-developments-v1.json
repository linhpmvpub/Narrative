{
  "version": "operating-developments-v2",
  "interruptions": {
    "actions": "\\b(?:paus(?:e|es|ed)|halt(?:s|ed)?|suspend(?:s|ed)?|stop(?:s|ped)?|delay(?:s|ed)?|cancel(?:s|led|ed)?)\\b",
    "objects": ["construction", "production", "manufacturing", "operations", "shipments", "deliveries", "data center", "data centre", "factory", "factories", "plant", "plants", "fab", "fabs", "production line"],
    "object_modifiers": "\\s*(?:(?:a|an|the|its|their|all|new|planned|ongoing|existing|chip|memory|semiconductor|component)\\s+){0,5}",
    "non_assertion": "\\b(?:no|not|never|without|denied|if|unless|may|might|could|would|can|risk|risks|prevent|prevents|avoid|avoids|potential|possible|hypothetical|simulation|simulated|rumor|rumour)\\b"
  },
  "object_bound_chars": 140,
  "objects": {
    "CAPACITY": ["capacity", "output", "production", "manufacturing", "facility", "facilities", "fab", "fabs", "factory", "factories", "plant", "plants", "campus", "site", "production line", "compute", "computing", "AI infrastructure"],
    "FINANCING": ["investment", "investments", "spending", "funding", "capital", "financing"],
    "DEMAND": ["demand", "orders", "order", "shipments", "deliveries", "sales", "backlog", "procurement"],
    "COST": ["prices", "price", "costs", "cost", "tariffs", "duties", "expenses"],
    "SUPPLY": ["supply", "supplies", "availability", "power", "electricity", "water", "inventory", "inventories"]
  },
  "hardware": ["GPU", "GPUs", "accelerator", "accelerators", "server", "servers", "cluster", "clusters", "supercomputer", "supercomputers", "racks", "AI infrastructure", "AI compute", "computing capacity"],
  "facilities": ["data center", "data centre", "datacenter", "campus", "facility", "facilities", "construction", "development", "project"],
  "funding": ["funds", "funding", "capital", "bonds", "financing", "investment", "investment partner"],
  "demonstration_pattern": "\\b(?:demo(?:nstration|nstrator)?s?|prototypes?|proof[ -]of[ -]concept|testbeds?|showcas\\w*)\\b",
  "planning_pattern": "\\b(?:plans?|planned|intends?|will|expects?|expected|proposes?|proposed|decides?|decided)\\b",
  "allocation_pattern": "\\b(?:raised?|secured?|invest(?:s|ed)?|fund(?:s|ed)?|committed)\\b",
  "clause_boundary": "[,;!?]|\\b(?:but|whereas|while|and)\\b",
  "object_boundary": "[,;!?]|\\b(?:for|to|from|with|by|which|that|but|whereas|while|and|across|alongside|in|of)\\b",
  "delivery": "disabled"
}
